#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Layer definitions

#define BASE 0
#define SYM 1
#define EXT 2
#define FNC 3
#define SYM2 4
#define ACCENT 5
#define SETTINGS 6

// -----------------

&mt {
    //  flavor = "tap-preferred";
    // tapping_term_ms = <200>;
};

&sk { ignore-modifiers; };

/ {
    macros {
        // sometimes my device thinks a modifier is being held down
        // pressing all modifiers fixes it.

        unstick: unstick {
            label = "ZM_unstick";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // both right thumb keys

        media-layer {
            timeout-ms = <300>;
            key-positions = <32 33>;
            bindings = <&mo 5>;
        };

        // internal-left & external-right thumb keys
        // both left thumb keys

        numpad-layer {
            timeout-ms = <300>;
            key-positions = <30 31>;
            bindings = <&mo 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base alpha layer

        default_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y           &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F  &kp G        &kp H           &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z  &kp X  &kp C  &kp V  &kp B        &kp N           &kp M  &kp COMMA  &kp DOT  &kp SLASH
                     &mo 2  &kp SPACE    &kp LEFT_SHIFT  &sl 1
            >;
        };

        // Numbers and high frequency symbols

        numbers-R2 {
            bindings = <
&kp N1  &kp N2                 &kp N3           &kp N4            &kp N5    &kp N6          &kp N7   &kp N8                &kp N9     &kp N0
&none   &kp LEFT_PARENTHESIS   &kp LEFT_BRACE   &kp LEFT_BRACKET  &none     &none           &kp SQT  &kp NON_US_BACKSLASH  &kp MINUS  &kp EQUAL
&none   &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RBKT          &none     &kp LEFT_SHIFT  &none    &none                 &none      &none
                                                &mo 3             &trans    &trans          &trans
            >;
        };

        // Main modifiers and arrow keys

        extend-L1 {
            bindings = <
&kp ESC           &none         &none         &none   &kp TAB           &none  &kp DELETE  &kp UP    &kp BACKSPACE  &kp BACKSPACE
&sk LEFT_CONTROL  &sk LEFT_ALT  &sk LEFT_WIN  &none   &none             &none  &kp LEFT    &kp DOWN  &kp RIGHT      &kp ENTER
&none             &none         &none         &none   &kp LEFT_SHIFT    &none  &none       &none     &none          &none
                                              &trans  &to 4             &none  &mo 3
            >;
        };

        // Function keys with modifiers

        function-L1+R2 {
            bindings = <
&kp F1     &kp F2    &kp F3        &kp F4  &kp F5    &kp F6        &kp F7        &kp F8        &kp F9   &kp F10
&sk LCTRL  &sk LALT  &sk LEFT_GUI  &none   &none     &none         &none         &none         &kp F11  &kp F12
&none      &none     &none         &none   &none     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none    &none
                                   &trans  &none     &none         &trans
            >;
        };

        // Low frequency symbols.

        numpad-L1+L2 {
            bindings = <
&none  &none  &none  &none   &none     &none  &kp N7  &kp N8  &kp N9  &none
&none  &none  &none  &none   &none     &none  &kp N4  &kp N5  &kp N6  &none
&none  &none  &none  &none   &none     &none  &kp N1  &kp N2  &kp N3  &none
                     &trans  &trans    &none  &none
            >;
        };

        // Used to type regional accents.

        media-R1+R2 {
            bindings = <
&none  &none  &none  &none  &none    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                     &none  &none    &none  &none
            >;
        };

        // Used to change the keyboard's settings.
    };
};
