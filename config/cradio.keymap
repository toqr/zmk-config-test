#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    //  flavor = "tap-preferred";
    // tapping_term_ms = <200>;
};

&sk { ignore-modifiers; };

/ {
    macros {
        unstick: unstick {
            label = "ZM_unstick";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // both right thumb keys

        media-layer {
            timeout-ms = <300>;
            key-positions = <32 33>;
            bindings = <&mo 5>;
        };

        numpad-layer {
            timeout-ms = <300>;
            key-positions = <30 31>;
            bindings = <&mo 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y           &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F  &kp G        &kp H           &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z  &kp X  &kp C  &kp V  &kp B        &kp N           &kp M  &kp COMMA  &kp DOT  &kp SLASH
                     &mo 2  &kp SPACE    &kp LEFT_SHIFT  &mo 1
            >;
        };

        numbers-R2 {
            bindings = <
&kp N1             &kp N2                 &kp N3           &kp N4            &kp N5            &kp N6      &kp N7     &kp N8     &kp N9     &kp N0
&kp SQT            &kp LEFT_PARENTHESIS   &kp LEFT_BRACE   &kp LEFT_BRACKET  &kp BACKSLASH     &kp MINUS   &kp EQUAL  &kp GRAVE  &kp TILDE  &kp ENTER
&kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RBKT          &kp PIPE          &kp DELETE  &none      &none      &none      &kp BACKSPACE
                                                           &mo 3             &kp LEFT_SHIFT    &tog 5      &trans
            >;
        };

        extend-L1 {
            bindings = <
&kp ESC           &kp GRAVE     &kp TILDE     &sk LSHIFT  &kp TAB         &kp DELETE  &kp MINUS  &kp LG(W)  &kp EQUAL  &kp BACKSPACE
&sk LEFT_CONTROL  &sk LEFT_ALT  &sk LEFT_WIN  &kp SPACE   &kp CAPSLOCK    &kp LEFT    &kp DOWN   &kp UP     &kp RIGHT  &kp ENTER
&kp LG(Z)         &kp LG(X)     &kp LG(C)     &kp LG(V)   &kp LG(L)       &kp N1      &kp N2     &kp N3     &kp N4     &kp N5
                                              &trans      &tog 4          &none       &mo 3
            >;
        };

        function-L1+R2 {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &kp F6        &kp F7        &kp F8        &kp F9   &kp F10
&kp F16  &kp F17  &kp F18  &kp F19  &kp F20    &kp F11       &kp F12       &kp F13       &kp F14  &kp F15
&kp F21  &kp F22  &kp F23  &kp F24  &none      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none    &none
                           &trans   &none      &none         &trans
            >;
        };

        numpad-L1+L2 {
            bindings = <
&kp ESC         &none  &kp C_BRIGHTNESS_INC  &kp C_VOLUME_UP    &kp TAB      &kp KP_DIVIDE    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&kp LEFT_SHIFT  &none  &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN  &kp SPACE    &kp KP_MULTIPLY  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_ENTER
&tog 4          &none  &none                 &kp C_MUTE         &none        &kp KP_SUBTRACT  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT
                                             &trans             &trans       &kp BACKSPACE    &kp NUMBER_0
            >;
        };

        mirrorNumpad-R1+R2 {
            bindings = <
&kp KP_PLUS   &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_DIVIDE      &kp TAB    &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC  &none  &kp ESC
&kp KP_ENTER  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MULTIPLY    &kp SPACE  &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC  &none  &kp LSHFT
&kp KP_DOT    &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_MINUS       &none      &kp C_MUTE         &none                 &none  &tog 5
                                    &kp KP_N0  &kp BSPC           &trans     &trans
            >;
        };
    };
};
